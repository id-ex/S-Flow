QDialog { 
    background-color: #2c2c2c; 
    color: white; 
}
QLabel { 
    color: #e0e0e0; 
    font-family: 'Segoe UI'; 
    font-size: 14px; 
}
QLineEdit { 
    padding: 5px; 
    border: 1px solid #555; 
    border-radius: 5px; 
    background-color: #3d3d3d; 
    color: white; 
    font-family: 'Consolas';
}
QLineEdit:focus {
    border: 2px solid #0078D4;
    background-color: #454545;
}
QPushButton {
    background-color: #0078D4;
    color: white;
    border: none;
    padding: 8px 15px;
    border-radius: 5px;
    font-weight: bold;
}
QPushButton:hover { 
    background-color: #006abc; 
}

QToolButton#magicContextButton {
    background-color: #3d3d3d;
    color: #f5d76e;
    border: 1px solid #666;
    border-radius: 5px;
    padding: 0;
    font-family: 'Segoe UI Emoji', 'Segoe UI Symbol', 'Segoe UI';
    font-size: 15px;
}

QToolButton#magicContextButton:hover {
    background-color: #474747;
    border-color: #0078D4;
}

QToolButton#magicContextButton:disabled {
    color: #bdbdbd;
    background-color: #353535;
    border-color: #555;
}
